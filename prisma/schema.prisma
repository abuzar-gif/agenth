generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  authVersion Int @default(0)
  accounts Account[]
  sessions Session[]
  profile Profile?
  tasks Task[]
  connectors Connector[]
  schedules Schedule[]
  agents Agent[]
  messages Message[]
  audits Audit[]
  conversations Conversation[]
  settings Settings?
  whatsAppSession WhatsAppSession?
  whatsAppKeys WhatsAppKey[]
  whatsAppContacts WhatsAppContact[]
  whatsAppMessages WhatsAppMessage[]
  whatsAppSends WhatsAppSend[]
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([provider,providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier,token])
}
model Profile {
  userId String @id
  language String @default("en")
  timezone String @default("Asia/Karachi")
  answers Json @default("{}")
  onboarded Boolean @default(false)
  onboardingStep Int @default(-1)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Task {
  id String @id @default(cuid())
  agentId String?
  userId String
  instruction String @db.Text
  status String @default("queued")
  plan Json?
  cursor Int @default(0)
  result String? @db.Text
  error String?
  approval Json?
  model String?
  tokens Int?
  durationMs Int?
  attempts Int @default(0)
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  events Event[]
  @@index([userId,createdAt])
}
model Event {
  id String @id @default(cuid())
  taskId String
  agent String
  kind String
  message String @db.Text
  data Json?
  createdAt DateTime @default(now())
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  @@index([taskId,createdAt])
}
model Connector {
  id String @id @default(cuid())
  userId String
  provider String
  encrypted String @db.Text
  metadata Json @default("{}")
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,provider])
}
model Schedule {
  id String @id @default(cuid())
  userId String
  instruction String
  cron String?
  timezone String @default("Asia/Karachi")
  nextRun DateTime
  paused Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([paused,nextRun])
}
model Agent {
  id String @id @default(cuid())
  connector String?
  provider String?
  userId String
  name String
  role String
  permissions String[]
  template String? @default("custom")
  avatarColor String? @default("violet")
  avatarShape String? @default("rounded")
  description String? @db.Text
  systemInstructions String? @db.Text
  memoryEnabled Boolean @default(false)
  approvalRequired Boolean @default(true)
  status String @default("ready")
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([userId,connector])
}
model Message {
  id String @id @default(cuid())
  userId String
  agent String
  conversationId String?
  conversation Conversation? @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  role String @default("user")
  model String?
  tokens Int?
  status String @default("completed")
  content String @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,createdAt])
}
model Audit {
  id String @id @default(cuid())
  userId String
  action String
  detail String?
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Conversation {
  id String @id @default(cuid())
  userId String
  title String @default("New conversation")
  generationId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  messages Message[]
  @@index([userId,updatedAt])
}
model Settings {
  userId String @id
  model String @default("auto")
  voice String @default("auto")
  speed Float @default(1)
  volume Float @default(0.9)
  autoplay Boolean @default(false)
  welcomeAutoplay Boolean @default(true)
  theme String @default("dark")
  microphoneId String @default("")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}


model WhatsAppSession {
  userId String @id
  state String @default("disconnected")
  mode String @default("qr")
  command String?
  phoneEncrypted String? @db.Text
  credsEncrypted String? @db.Text
  qrEncrypted String? @db.Text
  pairingEncrypted String? @db.Text
  consent Json @default("{}")
  expiresAt DateTime?
  lastConnected DateTime?
  heartbeat DateTime?
  owner String?
  leaseUntil DateTime?
  error String?
  updatedAt DateTime @updatedAt
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model WhatsAppKey {
  userId String
  category String
  keyId String
  encrypted String @db.Text
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,category,keyId])
}
model WhatsAppContact {
  userId String
  jid String
  encrypted String @db.Text
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,jid])
}
model WhatsAppMessage {
  userId String
  messageId String
  jid String
  fromMe Boolean @default(false)
  encrypted String @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@id([userId,messageId])
  @@index([userId,createdAt])
}
model WhatsAppSend {
  operationId String @id
  userId String
  state String @default("pending")
  payloadEncrypted String @db.Text
  resultEncrypted String? @db.Text
  createdAt DateTime @default(now())
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
